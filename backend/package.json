{
    "name": "shinzo-backend",
    "version": "1.0.0",
    "main": "server.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "build": "tsc -p tsconfig.json",
        "start": "node -r ts-node/register --env-file=.env src/server.ts",
        "start:prod": "NODE_PATH=./dist node dist/server.js"
    },
    "author": "Austin Born (austin@shinzolabs.com)",
    "dependencies": {
        "@babel/core": "^7.26.9",
        "@fastify/cors": "^10.1.0",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/swagger": "^9.3.0",
        "axios": "^1.8.1",
        "dotenv": "^16.4.7",
        "fastify": "^5.2.1",
        "form-data": "^4.0.4",
        "jsonwebtoken": "^9.0.2",
        "mailgun.js": "^12.0.3",
        "pg": "^8.13.3",
        "pino": "^9.6.0",
        "pino-pretty": "^12.0.0",
        "sequelize": "^6.37.5",
        "uuid": "^11.1.0",
        "yup": "^1.6.1"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.26.9",
        "@babel/preset-typescript": "^7.26.0",
        "@types/jest": "^29.5.12",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.13.5",
        "@types/pg": "^8.11.10",
        "@types/sequelize": "^4.28.20",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "jest": "^29.7.0",
        "supertest": "^6.3.4",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.test.ts"
        ],
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!src/**/*.test.ts",
            "!src/types/**",
            "!src/server.ts"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 80,
                "functions": 80,
                "lines": 80,
                "statements": 80
            }
        },
        "testPathIgnorePatterns": [
            "dist",
            "node_modules"
        ]
    }
}